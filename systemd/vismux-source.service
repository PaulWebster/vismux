[Unit]
Description=Squeezelite Visualiser Replicator Source Service
# Blocks boot until the network interface is fully up with an active IP
After=network-online.target squeezelite.service
Wants=network-online.target squeezelite.service

[Service]
Type=simple
# ExecStart - set the MAC address to the system that you want to replicate
ExecStart=/usr/local/bin/vismux --source --mac b8:27:eb:01:02:03 --timeout 3 --fps 60 --log-level 0
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
